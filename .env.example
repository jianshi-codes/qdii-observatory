# Local-only defaults. Change the password before exposing any port beyond loopback.
QDII_BIND_HOST=127.0.0.1
QDII_FRONTEND_PORT=5173
QDII_BACKEND_PORT=8000
QDII_POSTGRES_PORT=55432
QDII_POSTGRES_DB=qdii_observatory
QDII_POSTGRES_USER=qdii
QDII_POSTGRES_PASSWORD=change-this-local-password
QDII_ENABLE_PORTFOLIO=false
QDII_DATA_DIR=./.data

# Optional bind mount instead of the default named volume:
# QDII_PG_VOLUME_TYPE=bind
# QDII_PG_DATA_SOURCE=./.data/postgres

# Native development (outside Docker) may set this directly:
# QDII_DATABASE_URL=postgresql+psycopg://qdii:change-this-local-password@127.0.0.1:55432/qdii_observatory
QDII_RAW_DATA_DIR=./.data/raw
QDII_API_ORIGIN=http://127.0.0.1:8000
QDII_CORS_ORIGINS=http://127.0.0.1:5173
VITE_API_BASE_URL=
VITE_QDII_ENABLE_PORTFOLIO=false
